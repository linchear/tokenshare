# systemd user service for the Token Share delegate.
#   systemctl --user enable --now tokenshare
# Configuration: ~/.config/tokenshare/config.toml (see /usr/share/doc/tokenshare/).
[Unit]
Description=Token Share delegate
After=network-online.target

[Service]
ExecStart=/usr/bin/tokenshare
Restart=on-failure

[Install]
WantedBy=default.target
